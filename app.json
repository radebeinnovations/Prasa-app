{
  "expo": {
    "name": "Prasa App",
    "slug": "prasa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/transit-app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/transit-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/transit-app-icon.png",
        "backgroundColor": "#062451"
      },
      "package": "za.co.prasa.mobile"
    },
    "web": {
      "favicon": "./assets/transit-app-icon.png"
    },
    "scheme": "prasa-app",
    "plugins": [
      "expo-router"
    ]
  }
}
